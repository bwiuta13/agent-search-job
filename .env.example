# Email được mời (comma separated) - seed vào bảng users lần chạy đầu
# Để rỗng (ALLOWLIST_EMAILS=) -> website + API + MCP public, không cần đăng nhập
ALLOWLIST_EMAILS=friend@example.com
# Tài khoản đăng nhập cố định (tuỳ chọn): email + mã truy cập do bạn tự đặt thay cho mã ngẫu nhiên.
# Mã >= 12 ký tự, không dùng ký tự $ (Docker Compose hiểu là biến). Tạo nhanh: python3 -c 'import secrets; print(secrets.token_urlsafe(18))'
# Đổi mã rồi khởi động lại app -> mã cũ hết hiệu lực, mọi phiên đăng nhập của email này bị đăng xuất.
LOGIN_EMAIL=
LOGIN_CODE=

# Đường dẫn SQLite (mặc định data/jobs.db)
JOBS_DB=data/jobs.db

# LLM enrichment (tuỳ chọn - xem README mục LLM enrichment)
AI_PROVIDER=openai
AI_TEXT_MODEL=z-ai/glm-5.3
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tokenplan.api.greennode.ai/v1
OPENAI_REQUEST_TIMEOUT_SECONDS=90

# Trợ lý AI (/assistant)
# hội thoại (mọi người dùng) tự xoá sau N giờ không hoạt động; hồ sơ khách cũng vậy
ASSISTANT_CHAT_TTL_HOURS=24
# giới hạn mỗi người mỗi ngày
ASSISTANT_DAILY_MESSAGES=100
ASSISTANT_DAILY_WEB_SEARCHES=20
# trần CHUNG cho mọi khách (public mode) mỗi ngày: khách tự đổi cookie nên giới hạn theo từng người không đủ chặn
ASSISTANT_GUEST_DAILY_MESSAGES=300
ASSISTANT_GUEST_DAILY_WEB_SEARCHES=30

# Dọn dữ liệu (xem scripts/purge.py)
# ẩn job không thấy lại trên nguồn vừa quét sau N ngày (0 = tắt) - chạy cuối mỗi lần quét
JOB_STALE_DAYS=30
# make purge: xoá job đã ẩn quá N ngày (trừ job có người lưu) + crawl_runs cũ hơn N ngày
JOB_PURGE_AFTER_DAYS=90
CRAWL_RUNS_KEEP_DAYS=90

# Quét định kỳ tự động (scripts/scheduled_scan.py + vòng lặp trong server)
# 1 = bật vòng lặp quét theo lịch (SCAN_TIMES) trong tiến trình server web
#     (quét nguồn -> xoá job hết hạn/không còn tuyển -> gửi mail job mới)
# 0 = tắt vòng lặp; chạy bằng cron ngoài: CRON_TZ=Asia/Ho_Chi_Minh + 0 8,20 * * * cd <thư mục project> && python3 scripts/scheduled_scan.py
SCHEDULED_SCAN_ENABLED=1
# quét + gửi mail đúng các mốc giờ Việt Nam, cách nhau dấu phẩy (8h sáng và 8h tối)
SCAN_TIMES=08:00,20:00
# bỏ trống SCAN_TIMES -> quét mỗi N giờ (mặc định 12)
SCAN_INTERVAL_HOURS=12
# 1 = quét thêm 1 lượt ngay khi server khởi động (0 = chỉ quét đúng lịch, không quét/mail mỗi lần deploy)
SCAN_ON_STARTUP=0
# xoá hẳn job đã bị ẩn quá N ngày (0 = tắt xoá; mặc định 3)
SCAN_DELETE_AFTER_DAYS=3
# xoá hẳn job đã quá hạn nộp (kể cả job có người lưu) mỗi N giờ, chạy ngay khi server khởi động (0 = tắt)
EXPIRED_PURGE_HOURS=6
# fetch JD chi tiết từ trang nguồn cuối lượt quét (0 = tắt, nhanh hơn)
SCAN_JD_DETAILS=1
# link web trong mail job mới (đặt đúng domain khi chạy sau Nginx; bỏ trống -> link trang nguồn)
SITE_URL=

# Mail thông báo job mới sau mỗi lượt quét định kỳ (8h sáng, 8h tối)
# Bỏ trống SMTP_HOST/MAIL_TO -> không gửi mail (lượt quét vẫn chạy bình thường).
# Gmail: bật 2FA rồi tạo App Password tại https://myaccount.google.com/apppasswords
#        (dùng App Password, KHÔNG dùng mật khẩu đăng nhập thường).
# Ví dụ Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tencuaban@gmail.com
#   SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx   # App Password 16 ký tự
#   MAIL_FROM=tencuaban@gmail.com
#   MAIL_TO=ban@gmail.com,nguoib@gmail.com
# Kiểm tra cấu hình: python3 scripts/scheduled_scan.py --test-mail
SMTP_HOST=
# 587 = STARTTLS (khuyên dùng), 465 = SMTPS (đặt SMTP_SSL=1)
SMTP_PORT=587
SMTP_SSL=0
# Tài khoản đăng nhập SMTP (Gmail: địa chỉ Gmail + App Password)
SMTP_USER=
SMTP_PASSWORD=
# địa chỉ gửi (mặc định = SMTP_USER)
MAIL_FROM=
# người nhận, nhiều người cách nhau bằng dấu phẩy
MAIL_TO=
# tối đa số job liệt kê trong 1 mail (mặc định 30)
NEW_JOB_MAIL_MAX=30
# timeout SMTP giây (mặc định 30)
SMTP_TIMEOUT_SECONDS=30

# Docker Compose (tuỳ chọn). Trên server có dữ liệu cũ, đặt các giá trị này
# theo thư mục và UID/GID của service hiện tại để dùng chung database.
# DATA_DIR=/var/lib/agent-search-job
# BACKUP_DIR=/var/lib/agent-search-job/backups
# APP_UID=999
# APP_GID=988
